# Ensemble Events. Generated from redirects.csv, do not hand edit.
# 22 moved, 7 retired, 28 unchanged and needing no rule.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # one canonical host, https, no www, so a page is never indexed twice
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # a trailing slash, so /contact and /contact/ are not two pages
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(/$|\.[a-zA-Z0-9]{2,5}$)
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# Pages that are deliberately gone. 410 rather than 404 tells a crawler to stop asking.
RedirectMatch 410 ^/items-2/?$
RedirectMatch 410 ^/items-1/this-is-a-title-01/?$
RedirectMatch 410 ^/items-1/this-is-a-title-02/?$
RedirectMatch 410 ^/items-1/this-is-a-title-03/?$
RedirectMatch 410 ^/items/this-is-a-title-01/?$
RedirectMatch 410 ^/items/this-is-a-title-02/?$
RedirectMatch 410 ^/items/this-is-a-title-03/?$

# Moved for good.
Redirect 301 /ee-weddings /wedding-content-creation
Redirect 301 /weddings /wedding-content-creation
Redirect 301 /ee-core-philosophy /the-method
Redirect 301 /wedding-entertainment-services /wedding-packages
Redirect 301 /wedding-photo-entertainment /wedding-packages
Redirect 301 /copy-of-wedding-packages /wedding-packages
Redirect 301 /services /
Redirect 301 /services-1 /
Redirect 301 /photo-entertainment /wedding-packages
Redirect 301 /enclosed-photo-booth /wedding-packages
Redirect 301 /mirror-x-booth /wedding-packages
Redirect 301 /enclosedboothbook /wedding-packages
Redirect 301 /mirrorxbook /wedding-packages
Redirect 301 /photoboothalbums /clientservices
Redirect 301 /party-specials /wedding-packages
Redirect 301 /birthday-parties /wedding-packages
Redirect 301 /corporate-services /wedding-packages
Redirect 301 /eventgames /game-shows
Redirect 301 /happycouplegame /game-shows
Redirect 301 /officebestiecouple /game-shows
Redirect 301 /contactus /contact
Redirect 301 /holidays /holiday-parties

# A missing page should look like the site, not like Apache.
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
